# dependencies
node_modules/

# build output
dist/

# signing material — NEVER commit keystores or credentials
*.keystore
*.jks
android/release.keystore
android/debug.keystore
!android/make-debug-keystore.sh

# secrets
.env
.env.*
*.pem
*.key

# probes / scratch — keep the suite that CI runs; ignore one-off scratch probes
probe-*.mjs
